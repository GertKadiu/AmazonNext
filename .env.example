# Kopjoje këtë skedar si `.env.local` dhe plotëso vlerat nga AWS Console.
# `.env.local` është në .gitignore — nuk përfundon kurrë në Git.

# Rajoni ku krijove User Pool-in (p.sh. eu-central-1 për Frankfurt)
AWS_REGION=eu-central-1

# User Pool → Overview → "User pool ID"  (format: eu-central-1_XXXXXXXXX)
COGNITO_USER_POOL_ID=

# User Pool → App clients → klienti yt → "Client ID"
COGNITO_CLIENT_ID=

# User Pool → App clients → klienti yt → "Show client secret"
# (lëre bosh nëse e krijove app client-in PA secret)
COGNITO_CLIENT_SECRET=
