# Kopjoje këtë skedar si `.env.local` dhe plotëso vlerat nga AWS Console.
# `.env.local` është në .gitignore — nuk përfundon kurrë në Git.

# Rajoni ku krijove User Pool-in (p.sh. eu-central-1 për Frankfurt)
AWS_REGION=eu-central-1

# User Pool → Overview → "User pool ID"  (format: eu-central-1_XXXXXXXXX)
COGNITO_USER_POOL_ID=

# User Pool → App clients → klienti yt → "Client ID"
COGNITO_CLIENT_ID=

# User Pool → App clients → klienti yt → "Show client secret"
# (lëre bosh nëse e krijove app client-in PA secret)
COGNITO_CLIENT_SECRET=

# --- Amplify në browser (login me SRP) -------------------------------------
# Amplify xhiron te klienti, prandaj i duhen këto variabla NEXT_PUBLIC_
# (të dukshme edhe në browser — mos vër këtu asgjë sekrete).
#
# KUJDES: SRP në browser kërkon një App Client PUBLIK, pra PA client secret,
# me flow-in ALLOW_USER_SRP_AUTH të aktivizuar. Nëse app client-i i mësipërm ka
# secret, krijo një të ri pa secret dhe vendos ID-n e tij te NEXT_PUBLIC_...CLIENT_ID.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# --- DynamoDB --------------------------------------------------------------
# Emri i tabelës që krijove në DynamoDB → Tables
DYNAMODB_USERS_TABLE=Users

# Çelësat e përdoruesit IAM që ka të drejta VETËM mbi tabelën e mësipërme.
# IAM → Users → <emri> → Security credentials → Create access key.
# Secret-i shfaqet VETËM një herë — ruaje me të njëjtën kujdes si fjalëkalimin.
# Cognito nuk i përdor këta çelësa (operacionet e tij janë publike);
# i përdor vetëm DynamoDB, sepse çdo kërkesë atje duhet nënshkruar.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Supabase (migrim i përdoruesve nga Cognito) -----------------------------
# Project Settings → API
# URL dhe publishable key janë PUBLIKE (shkojnë në browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET KEY (sb_secret_... ose legacy service_role) = çelës ADMIN. Kurrë NEXT_PUBLIC_, kurrë në browser.
# E përdor vetëm serveri për të krijuar përdoruesin me të njëjtin sub të Cognito-s.
SUPABASE_SECRET_KEY=

# --- S3: fotot e profilit ---------------------------------------------------
# Emri i bucket-it (jo ARN, jo URL). Duhet PRIVAT — "Block all public access".
S3_AVATARS_BUCKET=

# --- Destinacioni i deploy-it me CDK ---------------------------------------
# ID-ja e llogarisë AWS ku shkon stack-u. Mbahet jashtë Git-it me qëllim.
CDK_DEPLOY_ACCOUNT=
CDK_DEPLOY_REGION=eu-central-1
