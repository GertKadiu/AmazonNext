# Kopjoje këtë skedar si `.env.local` dhe plotëso vlerat nga AWS Console.
# `.env.local` është në .gitignore — nuk përfundon kurrë në Git.

# Rajoni ku krijove User Pool-in (p.sh. eu-central-1 për Frankfurt)
AWS_REGION=eu-central-1

# User Pool → Overview → "User pool ID"  (format: eu-central-1_XXXXXXXXX)
COGNITO_USER_POOL_ID=

# User Pool → App clients → klienti yt → "Client ID"
COGNITO_CLIENT_ID=

# User Pool → App clients → klienti yt → "Show client secret"
# (lëre bosh nëse e krijove app client-in PA secret)
COGNITO_CLIENT_SECRET=

# --- DynamoDB --------------------------------------------------------------
# Emri i tabelës që krijove në DynamoDB → Tables
DYNAMODB_USERS_TABLE=Users

# Çelësat e përdoruesit IAM që ka të drejta VETËM mbi tabelën e mësipërme.
# IAM → Users → <emri> → Security credentials → Create access key.
# Secret-i shfaqet VETËM një herë — ruaje me të njëjtën kujdes si fjalëkalimin.
# Cognito nuk i përdor këta çelësa (operacionet e tij janë publike);
# i përdor vetëm DynamoDB, sepse çdo kërkesë atje duhet nënshkruar.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
